{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trend-machine Oracle Board",
  "description": "Wave 27: the forecast-explorer payload. One row per forecast in data/forecast_ledger.json \u2014 call type, forecast-time velocity, the topic's full stored velocity trajectory (live store merged with the resolution archive, points as recorded), its 48h window state (actual snapshots, coverage, slope, ready/short), due time, and the verdict when one exists. Pending stays pending; a window under 2 actuals is labeled short. Status and hit_rate are read from forecast-accuracy.json, never recomputed.",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "horizon_hours",
    "method",
    "honesty",
    "counts",
    "next_resolution_at",
    "by_state",
    "due_per_day",
    "entries"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "building history",
        "live"
      ]
    },
    "horizon_hours": {
      "type": "integer",
      "const": 48
    },
    "method": {
      "type": "string"
    },
    "honesty": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "recorded",
        "pending",
        "resolved",
        "unverifiable",
        "hits",
        "hit_rate",
        "ready",
        "short"
      ],
      "properties": {
        "recorded": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "unverifiable": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "short": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "next_resolution_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "by_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "recorded": {
            "type": "integer",
            "minimum": 0
          },
          "pending": {
            "type": "integer",
            "minimum": 0
          },
          "resolved": {
            "type": "integer",
            "minimum": 0
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          },
          "unverifiable": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "type": "integer",
            "minimum": 0
          },
          "short": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "due_per_day": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "pending": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "title",
          "state",
          "forecast_at",
          "due_at",
          "forecast_velocity",
          "topic_live",
          "status",
          "verdict",
          "window",
          "trajectory",
          "trajectory_n"
        ],
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "forecast_at": {
            "type": "string"
          },
          "due_at": {
            "type": "string"
          },
          "forecast_velocity": {
            "type": "number"
          },
          "peak_in_hours": {
            "type": [
              "number",
              "null"
            ]
          },
          "n_snapshots_at_forecast": {
            "type": [
              "integer",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic_live": {
            "type": "boolean"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "hit",
              "miss",
              "unverifiable"
            ]
          },
          "verdict": {
            "type": [
              "object",
              "null"
            ]
          },
          "window": {
            "type": "object",
            "required": [
              "n_actual_points",
              "first_ts",
              "last_ts",
              "coverage_hours",
              "slope_per_hour",
              "ready"
            ],
            "properties": {
              "n_actual_points": {
                "type": "integer",
                "minimum": 0
              },
              "first_ts": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_ts": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "coverage_hours": {
                "type": "number",
                "minimum": 0
              },
              "slope_per_hour": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ready": {
                "type": "boolean"
              }
            }
          },
          "trajectory": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "trajectory_n": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}