{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trend-machine forecast accuracy log",
  "description": "Wave 6: the Oracle's own forecast-vs-actual scorecard. Decisive forecasts are recorded in a ledger and scored hit/miss after a 48h horizon; wave 14 adds a terminal 'unverifiable' verdict (48h passed, <2 actual snapshots \u2014 counted separately, never in the hit rate). Status is 'building history' until 10+ forecasts resolve decisively; hit_rate is null before that.",
  "type": "object",
  "required": [
    "generated_at",
    "status",
    "method",
    "horizon_hours",
    "resolution_rules",
    "counts",
    "hit_rate",
    "hit_rate_note",
    "by_state",
    "recent"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "building history",
        "live"
      ]
    },
    "method": {
      "type": "string"
    },
    "horizon_hours": {
      "type": "integer",
      "const": 48
    },
    "resolution_rules": {
      "type": "object",
      "properties": {
        "rising_accelerating": {
          "type": "string"
        },
        "peaking": {
          "type": "string"
        },
        "fading": {
          "type": "string"
        },
        "unverifiable": {
          "type": "string"
        }
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "recorded": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "unverifiable": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hit_rate": {
      "type": [
        "number",
        "null"
      ]
    },
    "hit_rate_note": {
      "type": "string"
    },
    "by_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "resolved": {
            "type": "integer",
            "minimum": 0
          },
          "hits": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "forecast_at": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "peak_in_hours": {
            "type": [
              "number",
              "null"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "hit",
              "miss",
              "unverifiable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "actual_slope": {
            "type": [
              "number",
              "null"
            ]
          },
          "actual_end_velocity": {
            "type": [
              "number",
              "null"
            ]
          },
          "actual_max_velocity": {
            "type": [
              "number",
              "null"
            ]
          },
          "n_actual_points": {
            "type": [
              "integer",
              "null"
            ]
          },
          "n_snapshots": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "upcoming_resolutions": {
      "type": "array",
      "description": "Pending forecasts grouped by the day their 48h horizon lands (real ledger dates).",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "pending": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "recorded_per_day": {
      "type": "array",
      "description": "Forecasts recorded per day (the ledger's own pulse, from real timestamps).",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "recorded": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "by_confidence": {
      "type": "object",
      "description": "Wave 9: hit rate by the confidence level claimed at forecast time. Rows are honest \u2014 no rate until that level has 10+ resolved.",
      "properties": {
        "high": {
          "$ref": "#/properties/by_state/additionalProperties"
        },
        "medium": {
          "$ref": "#/properties/by_state/additionalProperties"
        },
        "low": {
          "$ref": "#/properties/by_state/additionalProperties"
        }
      }
    }
  }
}