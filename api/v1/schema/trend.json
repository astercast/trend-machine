{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trend-machine topic",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "category",
    "platforms",
    "hashtags",
    "velocity",
    "opportunity_score",
    "first_seen",
    "last_seen",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "description": "Seeded topics may carry researched starting-point figures in the summary \u2014 treat as baselines, not live measurements."
    },
    "category": {
      "type": "string"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "velocity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "saturation": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "opportunity_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "first_seen": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "stale": {
      "type": "boolean"
    },
    "seeded": {
      "type": "boolean"
    },
    "seed_note": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ]
      }
    },
    "angles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "who_to_watch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "format_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Wave 2: pattern-detected meme-format signals (pov/challenge/sound/dance/meme/duet/stitch/green-screen/template/trend)."
    },
    "trend_type": {
      "type": "string",
      "enum": [
        "format",
        "topic",
        "format+topic"
      ],
      "description": "Wave 7: 'format' = a reusable template others can fill (dance, caption variant, sound, challenge); 'topic' = a subject/event to cover; 'format+topic' = an event-driven topic riding a meme template. Rule-derived from format_tags + category."
    },
    "verification": {
      "type": "string",
      "enum": [
        "verified",
        "single-source",
        "unverified"
      ],
      "description": "Wave 7 (seeded topics): 'verified' = 2+ real sources; 'single-source' = one real source; 'unverified' = claimed sources not found on re-check \u2014 confirm live before building on it."
    },
    "guide_links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform_hits": {
      "type": "object",
      "description": "Wave 6: recent hit timestamps per platform (last 48h window). Powers the per-platform velocity history.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}