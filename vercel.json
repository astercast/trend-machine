{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash pipeline/refresh.sh && python3 scripts/write_health.py",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/trends.flat.js",
      "destination": "/static/v1/trends.flat.js"
    }
  ],
  "functions": {
    "api/trends.js": {
      "maxDuration": 10
    },
    "api/velocity.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": ".",
  "trailingSlash": false
}
