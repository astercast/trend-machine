{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py && node scripts/build_forecasts.js",
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/wire",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/trends.flat.js",
      "destination": "/static/v1/trends.flat.js"
    }
  ],
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/trends.js": {
      "maxDuration": 10
    },
    "api/forecasts.js": {
      "maxDuration": 10
    },
    "api/velocity.js": {
      "maxDuration": 10
    },
    "api/cron/wire.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ],
      "source": "/api/(.*)"
    },
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ],
      "source": "/(.*)"
    }
  ],
  "installCommand": "echo 'no dependencies'",
  "outputDirectory": ".",
  "trailingSlash": false
}
